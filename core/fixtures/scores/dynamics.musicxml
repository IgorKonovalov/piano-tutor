<?xml version="1.0" encoding="UTF-8"?>
<!-- Dynamics and a hairpin on a grand staff, and nothing else to distract
     from them (ADR-0018). Four bars of 4/4.

     Right hand (staff 1): pp in bar 1, a crescendo wedge across bar 2 that
     ends on the ff written at the start of bar 3, and p in bar 4. The wedge
     has a written target, which is where its end level comes from: OSMD
     reads a wedge's span but never its volumes.

     Left hand (staff 2): one mf in bar 1 and whole notes after it. It is
     there so a test can show that a dynamic belongs to the staff it is
     written on: the right hand's levels must not move because of it. -->
<score-partwise version="3.1">
  <work>
    <work-title>Dynamics</work-title>
  </work>
  <part-list>
    <score-part id="P1">
      <part-name>Piano</part-name>
