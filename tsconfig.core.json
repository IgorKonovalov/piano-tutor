{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "noEmit": true
  },
  "include": [
    "core/**/*",
    "shared/**/*",
    "electron/**/*.test.ts",
    "renderer/**/*.test.ts",
    "renderer/**/*.test.tsx",
    "e2e/**/*",
    "vitest.config.ts",
    "playwright.config.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "dist", "release"]
}
