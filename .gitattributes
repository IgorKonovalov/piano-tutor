# Normalise line endings to LF in the repository; the working copy follows core.autocrlf.
# Keeps diffs free of CRLF churn across the Windows checkout and any CI runner.
* text=auto eol=lf

# Shell hooks must stay LF or sh refuses them on Windows.
.githooks/* text eol=lf
*.sh text eol=lf

# Binary fixtures never get touched. A .mxl is a zip: line-ending translation
# would corrupt it, and the content-addressed score id with it.
*.mid binary
*.mxl binary
*.png binary
*.ico binary
*.woff2 binary
